@model RegisterVM   
@{ViewData["Title"] = "Register";}

<h1>Register a new account</h1>


<form asp-action="Register" method="post">
    <div asp-validation-summary="All" class="text-danger" ></div>

    <div class="form-group row">
        <div class="col-sm-2">
            <label>User Name:</label>
        </div>
        <div class="col-sm-4">
            <input asp-for="UserName" class="form-control" />
        </div>
        <div class="col">
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-2">
            <label>First Name:</label>
        </div>
        <div class="col-sm-4">
            <input asp-for="FirstName" class="form-control" />
        </div>
        <div class="col">
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-2">
            <label>Last Name:</label>
        </div>
        <div class="col-sm-4">
            <input asp-for="LastName" class="form-control" />
        </div>
        <div class="col">
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-2">
            <label>Email Address:</label>
        </div>
        <div class="col-sm-4">
            <input type="email" asp-for="Email" class="form-control" />
        </div>
        <div class="col">
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-2">
            <label>Password:</label>
        </div>
        <div class="col-sm-4">
            <input type="password" asp-for="Password" class="form-control" />
        </div>
        <div class="col">
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-2">
            <label>Confirm Password:</label>
        </div>
        <div class="col-sm-4">
            <input type="password" asp-for="ConfirmPassword" class="form-control" />
        </div>
        <div class="col">
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="InstitutionName">Institution: </label>
        <select name="InstitutionName">
            @foreach (Institution inst in Model.Institutions)
            {
                <option value=@inst.InstitutionName>@inst.InstitutionName</option>
            }
        </select>
    </div>       


    <script type="text/javascript">
    function ShowHideDiv(chkTeach) {
        var dvInstructor = document.getElementById("dvInstructor");
        dvInstructor.style.display = chkTeach.checked ? "block" : "none";
    }
</script>
<label for="chkTeach">
    <input type="checkbox" asp-for="IsInstructor" id="chkTeach" onclick="ShowHideDiv(this)" />
    Are you an Instructor?
</label>

<div id="dvInstructor" style="display: none">
    Instructor Code:
    <input type="text" id="txtInstructorCode" asp-for="InstructorCode" />
</div>


    <div class="row">
        <button type="submit" class="btn btn-primary">Register</button>
    </div>
    <div class="row">
        Already Registered? <a asp-action="Login"> Login</a>
    </div>
</form>


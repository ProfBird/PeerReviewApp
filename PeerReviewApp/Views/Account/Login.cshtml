@model LoginVM
@{
    ViewData["Title"] = "Login";
}

<section>
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6 offset-sm-6 p-5">
                <h3>Log In</h3>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <form method="post" asp-action="Login">
                    <div class="form-group row">
                        <div class="form-group col-sm-6">
                           <input type="text" asp-for="UserName" class="form-control" placeholder="User Name" />
                        </div>

                        <div class="col">
                            <span asp-validation-for="UserName"
                                  class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="form-group col-sm-6">
                           <input type="Password" asp-for="Password" class="form-control" placeholder="Password" />
                        </div>

                        <div class="col">
                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <input type="checkbox" title="Remember Me" asp-for="RememberMe"
                                   class="form-check-inline" />
                            <label asp-for="RememberMe">Remember Me</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <button type="submit" class="btn btn-primary">Log In</button>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            Not registered? 
                            <a asp-action="Register"> Register Now!</a>
                        </div>
                    </div>
                </form>
                </div>
                </div>
            </div>
</section>

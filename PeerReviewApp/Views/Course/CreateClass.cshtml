@model CreateClassVM

@{
    ViewData["Title"] = "Create New Class";
}
@using Microsoft.AspNetCore.Identity;
@inject SignInManager<AppUser> signInManager;

<div class="container">
    <div class="card border-0 shadow my-5">
        <div class="card-body p-5">
            <h4 class="fw-light">Create Class</h4>

            <form asp-action="CreateClass" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                @*-----------------Institution Name-----------------*@
                <div class="form-group">
                    <label asp-for="@Model.Institution.InstitutionId">Institution Name: <strong>@Model.Institution.InstitutionName</strong> </label>
                    <input type="hidden" asp-for="@Model.Institution.InstitutionId" value="@Model.Institution.InstitutionId"/>
                    <span asp-validation-for="Institution.InstitutionId"></span>
                </div>
                @*----------------Instructor-----------------*@
                <div class="form-group">
                    <label asp-for="@Model.Instructor.Id">Instructor: <strong>@Model.Instructor.FirstName @Model.Instructor.LastName</strong> </label>
                    <input type="hidden" asp-for="@Model.Instructor.Id" value="@Model.Instructor.Id"/>
                    <span asp-validation-for="Instructor.Id"></span>
                </div>
                @*----------------Courses-----------------*@
                <div class="form-group">
                    <label asp-for="@Model.Course.CourseId">Parent Course: </label>
                    <select name="Course.CourseId">
                        @if (@Model.Courses != null)
                        {
                            @foreach (Course crs in Model.Courses)
                            {
                                <option value=@crs.CourseId>@crs.CourseName</option>
                            }
                        }    
                        else
                        {
                            <option>No Courses registered at Institution!</option>
                        }                        
                    </select>
                    <span asp-validation-for="Course"></span>
                </div>


                @*------------------Term-------------------*@
                <div class="form-group">
                    <label asp-for="@Model.Term.TermId">Term: </label>
                    <select name="Term.TermId">
                        @if (@Model.Terms != null)
                        {
                            @foreach (Term term in Model.Terms)
                            {
                                <option value=@term.TermId>@term.TermName</option>
                            }
                        }
                        else
                        {
                            <option>No Terms have been setup at Institution!</option>
                        }     
                    </select>
                    <span asp-validation-for="Term"></span>
                </div>
                
                <button type="submit" class="btn btn-primary">Submit</button>
                <a asp-controller="Course" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                
            </form>
        </div>
    </div>
</div>



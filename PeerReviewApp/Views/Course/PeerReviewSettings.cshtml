@model PeerReviewPartnersVM

<div>
    <a asp-controller="Course" asp-action="ClassPage" asp-route-id="@Model.Class.ClassId" class="btn btn-primary"><i class="far fa-arrow-alt-circle-left"></i> Back</a>
</div>

<div class="container">
    <div class="card border-0 shadow my-5">
        <div class="card-body p-5">
        
        <h4>Awaiting Partner Assignment</h4>
        @if (Model.UnassignedStudents.Count == 0)
        {
            <div>All Students have been assigned peer review partners</div>
        }
        else
        {
            <form asp-action="PeerReviewSettings" method="post">
            <input type="hidden" asp-for="@Model.Class.ClassId" />

                <div class="form-group">
                    <label asp-for="Student1.Id">Choose Student: </label>
                            <select name="Student1.Id">
                                @foreach (AppUser stu in Model.UnassignedStudents)
                                {
                                    <option value="@stu.Id">@stu.FirstName @stu.LastName</option>
                                }
                            </select>
                </div>
                
                <div class="form-group">
                    <label asp-for="Student2.Id">Choose Partner: </label>
                    <select name="Student2.Id">
                        @foreach (AppUser stu in Model.UnassignedStudents)
                        {
                            <option value="@stu.Id">@stu.FirstName @stu.LastName</option>
                        }
                    </select>
                </div>              

                <button type="submit" class="btn btn-primary">Assign Partners</button>
            </form>            
        }

        </div>
    </div>
</div>

<div class="container">
    <div class="card border-0 shadow my-5">
        <div class="card-body p-5">
            <h4>Peer Review Partners</h4>
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Names</th>
                            <th>Unassign</th>
                        </tr>
                    </thead>
                        <tbody>
                            @foreach (SelectListItem s in ViewData["partners"] as List<SelectListItem>)
                            {
                                <tr>
                                    <td>@s.Text</td>
                                    <td><a asp-controller="Course" asp-action="PeerReviewUnassign" asp-route-id="@s.Value"><i class="far fa-trash-alt"></i></a></td>
                                </tr>
                            }
                        </tbody>
                </table>
        </div>
    </div>
</div>




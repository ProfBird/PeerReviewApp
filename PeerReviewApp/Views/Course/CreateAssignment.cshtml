@model AssignmentVM

@{
    ViewData["Title"] = ViewBag.Caption + " Assignment";
    var AssignmentTemplate = (AssignmentTemplate)ViewData["AssignmentTemplate"];
    var PeerReviewTemplate = (PeerReviewTemplate)ViewData["PeerReviewTemplate"];
}

<div class="container">
    <div class="card border-0 shadow my-5">
        <div class="card-body p-5">
            <h4 class="fw-light">Create Assignment</h4>

            <form enctype="multipart/form-data" asp-action="CreateAssignment" method="post">
                <input type="hidden" asp-for="ClassId" value="@Model.ClassId" />
                <input type="hidden" asp-for="AssignmentId"/>
                <input type="hidden" asp-for="FileName"/>

                <div asp-validation-summary="All" class="text-danger"></div>
                
                <div class="form-group">
                    <label asp-for="AssignmentName">Assignment Name: </label>
                    <input asp-for="AssignmentName" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="AssignmentInstructions">Instructions: </label>
                    <textarea asp-for="AssignmentInstructions" class="form-control"></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="AssignmentDueDate">Due Date: </label>
                    <input class="form-control" asp-for="AssignmentDueDate" asp-format="MM/dd/yyyy hh:mm tt"/>
                    <span asp-validation-for="AssignmentDueDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PeerReviewDueDate">Peer Review Due Date: </label>
                    <input class="form-control" asp-for="PeerReviewDueDate" asp-format="MM/dd/yyyy hh:mm tt"/>
                    <span asp-validation-for="PeerReviewDueDate" class="text-danger"></span>
                </div>
                <label><strong>Assignment Template</strong></label>

                @if (AssignmentTemplate == null)
                {
                    <dl>
                        <dd>
                            <input asp-for="@Model.AssignmentTemplateFormFile" type="file"/>
                        </dd>
                    </dl>                    
                }
                else
                {
                    <p>@AssignmentTemplate.TemplateName</p>
                    @if (Model.AssignmentId != 0)
                    {
                        <a asp-controller="Course" asp-action="DownloadAssignmentTemplate" asp-route-id="@AssignmentTemplate.AssignmentId" asp-route-view="EditAssignement" class="btn btn-sm btn-primary"><i class="far fa-arrow-alt-circle-down"></i> Download Assignment Template</a>
                        <a asp-controller="Course" asp-action="DeleteAssignmentTemplate" asp-route-id="@AssignmentTemplate.AssignmentId" asp-route-view="EditAssignement" class="btn btn-sm btn-danger"><i class="far fa-trash-alt"></i> Delete Assignment Template</a>                        
                    }

                }
                <br />
                <br />
                <label><strong>Peer Review Template</strong></label>
                @if (PeerReviewTemplate == null)
                {
                    <dl>
                        <dd>
                            <input asp-for="@Model.PeerReviewTemplateFormFile" type="file" />
                        </dd>
                    </dl>
                }
                else
                {
                    <p>@PeerReviewTemplate.TemplateName</p>
                    @if (Model.AssignmentId != 0)
                    {
                    <a asp-controller="Course" asp-action="DownloadPeerReviewTemplate" asp-route-id="@PeerReviewTemplate.AssignmentId" asp-route-view="EditAssignement" class="btn btn-sm btn-primary"><i class="far fa-arrow-alt-circle-down"></i> Download Peer Review Template</a>
                    <a asp-controller="Course" asp-action="DeletePeerReviewTemplate" asp-route-id="@PeerReviewTemplate.AssignmentId" asp-route-view="EditAssignement" class="btn btn-sm btn-danger"><i class="far fa-trash-alt"></i> Delete Peer Review Template</a>                        
                    }
                }
                <br />
                <br />

                <button type="submit" class="btn btn-primary">@ViewBag.Caption</button>
                <a asp-controller="Course" asp-action="ClassPage" asp-route-id="@Model.ClassId" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

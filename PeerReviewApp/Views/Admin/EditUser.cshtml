@model UserViewModel

@{
    ViewData["Title"] = " | Edit User";
}

<div>
    <a asp-controller="Institution" asp-action="Edit" asp-route-id="@Model.User.InstitutionId" class="btn btn-primary"><i class="far fa-arrow-alt-circle-left"></i> Back</a>
    <h1>@Model.User.FirstName @Model.User.LastName</h1>
</div>

<div class="container">
    <div class="card border-0 shadow my-5">
        <div class="card-body p-5">
            <h4 class="fw-light">User Details</h4>

            <form asp-action="EditUser" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for="@Model.User.Id" />

                @*-----------------User Name-----------------*@
                <div class="form-group">
                    <label asp-for="@Model.User.UserName">User Name: </label>
                    <input asp-for="@Model.User.UserName" value="@Model.User.UserName"/>
                    <span asp-validation-for="User.UserName"></span>
                </div>
                @*----------------First Name-----------------*@
                <div class="form-group">
                    <label asp-for="@Model.User.FirstName">First Name: </label>
                    <input asp-for="@Model.User.FirstName" value="@Model.User.FirstName"/>
                    <span asp-validation-for="User.FirstName"></span>
                </div>
                @*----------------Last Name-----------------*@
                <div class="form-group">
                    <label asp-for="@Model.User.LastName">Last Name: </label>
                    <input asp-for="@Model.User.LastName" value="@Model.User.LastName"/>
                    <span asp-validation-for="User.LastName"></span>
                </div>
                @*------------------Email-------------------*@
                <div class="form-group">
                    <label asp-for="@Model.User.Email">Email: </label>
                    <input asp-for="@Model.User.Email" value="@Model.User.Email"/>
                    <span asp-validation-for="User.Email"></span>
                </div>

                <button type="submit" class="btn btn-primary">Submit</button>
                <a asp-controller="Institution" asp-action="Edit" asp-route-id="@Model.User.InstitutionId" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
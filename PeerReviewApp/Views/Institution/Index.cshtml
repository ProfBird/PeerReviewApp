@model IEnumerable<Institution>
@{
    ViewData["Title"] = "Institutions";
}
<div>
    <a asp-controller="Admin" asp-action="Index" class="btn btn-primary"><i class="far fa-arrow-alt-circle-left"></i> Back</a>
    <h1>Manage Institutions</h1>
</div>

<div>
    <a asp-controller="Institution" asp-action="Create" class="btn btn-outline-secondary mr-1"><i class="fas fa-plus-circle"></i> Create Institution</a>
    <br />
</div>

<div class="container">
    <div class="card border-0 shadow my-5">
        <div class="card-body p-5">
            <h1 class="fw-light">Institutions</h1>

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Institution</th>
                        <th>Member Count</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Institution inst in Model)
                    {
                       <tr onclick="location.href = '@(Url.Action("Details", "Institution", new { id = @inst.InstitutionId }))'">
                           <td>@inst.InstitutionId</td>
                           <td>@inst.InstitutionName</td>
                           <td>@inst.Members.Count</td>
                           <td><a asp-controller="Institution" asp-action="Edit" asp-route-id="@inst.InstitutionId"><i class="far fa-edit"></i></a></td>
                           <td><a asp-controller="Institution" asp-action="Delete" asp-route-id="@inst.InstitutionId"><i class="far fa-trash-alt"></i></a></td>         
                       </tr> 
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

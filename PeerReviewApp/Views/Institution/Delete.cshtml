@model Institution

@{
    ViewData["Title"] = "Delete Institution";
}

<div class="container">
    <div class="card border-0 shadow my-5">
        <div class="card-body p-5">
            <h4 class="fw-light">@Model.InstitutionName</h4>
            <h5>Are you sure you would like to delete the institution <strong>@Model.InstitutionName</strong>?</h5>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="@Model.InstitutionId" />

                <button type="submit" class="btn btn-primary">Delete</button>
                <a asp-controller="Institution" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
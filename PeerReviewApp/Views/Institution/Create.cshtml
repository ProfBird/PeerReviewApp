@model Institution
@{
    ViewData["Title"] = "Create Institution";
}

<div>
    <a asp-controller="Institution" asp-action="Index" class="btn btn-primary"><i class="far fa-arrow-alt-circle-left"></i> Back</a>
    <h1>Create Institutions</h1>
</div>

<form asp-action="Create" method="Post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="InstitutionName"></label>
        <input asp-for="InstitutionName" class="form-control"/>
    </div>

    <div class="form-group">
        <label asp-for="InstructorCode">Instructor Code:</label>
        <input asp-for="InstructorCode" class="form-control"/>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-controller="Institution" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

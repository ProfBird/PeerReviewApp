@model TermVM
@{
    ViewData["Title"] = @ViewBag.Caption + " Term";
}

<div>
    <a asp-controller="Institution" asp-action="Edit" asp-route-id="@Model.InstitutionId" class="btn btn-primary"><i class="far fa-arrow-alt-circle-left"></i> Back</a>
    <h1>@ViewBag.Caption Term</h1>
</div>

<form asp-action="CreateTerm" method="Post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="InstitutionId" />
    <input type="hidden" asp-for="TermId" />

    <div class="form-group">
        <label asp-for="TermName"></label>
        <input asp-for="TermName" class="form-control"/>
    </div>

    <div class="form-group">
        <label asp-for="TermBeginDate"></label>
        <input asp-for="TermBeginDate" class="form-control" asp-format="MM/dd/yyyy hh:mm tt"/>
    </div>

    <div class="form-group">
        <label asp-for="TermEndDate"></label>
        <input asp-for="TermEndDate" class="form-control" asp-format="MM/dd/yyyy hh:mm tt"/>
    </div>
    <button type="submit" class="btn btn-primary">@ViewBag.Caption</button>
    <a asp-controller="Institution" asp-action="Edit" asp-route-id="@Model.InstitutionId" class="btn btn-outline-secondary">Cancel</a>
</form>
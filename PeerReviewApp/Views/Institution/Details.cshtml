@model InstitutionVM

@{
    ViewData["Title"] = " | " + Model.InstitutionName;
}

<div>
    <a asp-controller="Institution" asp-action="Index" class="btn btn-primary"><i class="far fa-arrow-alt-circle-left"></i> Back</a>
    <h1>@Model.InstitutionName</h1>
</div>

<div class="container">
    <div class="card border-0 shadow my-5">
        <div class="card-body p-5">
            <h4 class="fw-light">Members</h4>

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>UserName</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Roles</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Members.Count == 0)
                    {
                        <tr>
                            <td colspan="5">No members have been added yet!</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (AppUser user in Model.Members)
                        {
                            <tr onclick="location.href = '@(Url.Action("UserDetails", "Admin", new { id = @user.Id }))'">
                                <td>@user.Id</td>
                                <td>@user.UserName</td>
                                <td>@user.LastName, @user.FirstName</td>
                                <td>@user.Email</td>
                                @if (user.RoleNames != null)
                                {
                                    <td>
                                        @foreach (String role in user.RoleNames)
                                        {
                                                @role;

                                        }
                                    </td>
                                }
                                else
                                {
                                    <td>None</td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="container">
    <div class="card border-0 shadow my-5">
        <div class="card-body p-5">
            <h4 class="fw-light">Departments</h4>

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Department Id</th>
                        <th>Department</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Departments.Count == 0)
                    {
                        <tr>
                            <td colspan="5">No departments have been created yet!</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (Department dpt in Model.Departments)
                        {
                            <tr onclick="location.href = '@(Url.Action("Department", "Institution", new { id = @dpt.DepartmentId }))'">
                                <td>@dpt.DepartmentId</td>
                                <td>@dpt.DepartmentName</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="container">
    <div class="card border-0 shadow my-5">
        <div class="card-body p-5">
            <h4 class="fw-light">Terms</h4>

            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Term Id</th>
                        <th>Term</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Terms.Count == 0)
                    {
                        <tr>
                            <td colspan="5">No Terms have been created yet!</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (Term term in Model.Terms)
                        {
                            <tr onclick="location.href = '@(Url.Action("Term", "Institution", new { id = @term.TermId }))'">
                                <td>@term.TermId</td>
                                <td>@term.TermName</td>
                                <td>@term.TermBeginDate</td>
                                <td>@term.TermEndDate</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

